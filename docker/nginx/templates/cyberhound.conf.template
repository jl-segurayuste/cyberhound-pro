# CyberHound Pro — nginx delante de la aplicación (docker-compose.production.yml).
# Plantilla: el entrypoint de nginx sustituye ${CH_DOMAIN} al arrancar.
limit_req_zone $binary_remote_addr zone=cyberhound_api:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=cyberhound_login:10m rate=5r/m;

upstream cyberhound_backend {
    server cyberhound:8443;
    keepalive 16;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${CH_DOMAIN};
    server_tokens off;
    client_max_body_size 10m;

    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Comunes a todas las rutas (la app ya pone CSP, X-Frame-Options, etc.)
    proxy_ssl_verify off;          # la app usa su certificado autofirmado interno
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    location = /login {
        limit_req zone=cyberhound_login burst=3 nodelay;
        proxy_pass https://cyberhound_backend;
    }
    location /api/ {
        limit_req zone=cyberhound_api burst=50 nodelay;
        proxy_pass https://cyberhound_backend;
    }
    location /ws {
        proxy_read_timeout 1h;
        proxy_pass https://cyberhound_backend;
    }
    location / {
        proxy_pass https://cyberhound_backend;
    }
}
