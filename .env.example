# CyberHound Pro — Variables de entorno
# Copia este fichero a .env y ajusta los valores
# cp .env.example .env

# ── Credenciales de acceso a la interfaz web ──────────────────────────────────
CH_USERNAME=admin
CH_PASSWORD=cambia_esta_contraseña

# Puerto de escucha
CH_PORT=8443

# ── API Keys para inteligencia externa (todas opcionales) ─────────────────────
# Shodan: escaneo de dispositivos expuestos en internet — shodan.io
SHODAN_API_KEY=

# VirusTotal: análisis de ficheros y reputación de IPs — virustotal.com
VT_API_KEY=

# AbuseIPDB: base de datos de IPs maliciosas — abuseipdb.com
ABUSEIPDB_KEY=

# GreyNoise: clasificación de tráfico de red — greynoise.io
GREYNOISE_KEY=

# AlienVault OTX: threat intelligence — otx.alienvault.com
OTX_KEY=

# HaveIBeenPwned: emails en brechas de datos — haveibeenpwned.com
HIBP_API_KEY=

# ── Imagen Docker ─────────────────────────────────────────────────────────────
# Para usar la imagen de Docker Hub en lugar de la de GHCR:
# CYBERHOUND_IMAGE=qjossyx/cyberhound-pro:latest
CYBERHOUND_IMAGE=ghcr.io/qjossyx/cyberhound-pro:latest
