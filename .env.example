# CyberHound Pro — variables de entorno (cp .env.example .env)

# ── Acceso a la interfaz web ─────────────────────────────────────────────────
CH_USERNAME=admin
# Vacía: en el primer arranque se genera una contraseña y se muestra en el log.
# Solo se usa al crear /data/config.yaml; después se cambia con 'cyberhound setup'.
CH_PASSWORD=
# 127.0.0.1 = solo este equipo; 0.0.0.0 = toda la red local
CH_HOST=127.0.0.1
CH_PORT=8443

# ── Producción (docker-compose.production.yml) ───────────────────────────────
POSTGRES_PASSWORD=
CH_DOMAIN=localhost
CH_HTTP_PORT=80
CH_HTTPS_PORT=443

# ── Threat intelligence (todas opcionales) ───────────────────────────────────
SHODAN_API_KEY=
VT_API_KEY=
ABUSEIPDB_KEY=
GREYNOISE_KEY=
OTX_KEY=
HIBP_API_KEY=

# ── Imagen ───────────────────────────────────────────────────────────────────
# Por defecto la publicada por el CI; 'docker compose build' crea una local.
# CYBERHOUND_IMAGE=ghcr.io/jl-segurayuste/cyberhound-pro:latest
